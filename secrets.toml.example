# Copy this file to  .streamlit/secrets.toml  (create the .streamlit folder)
# and adapt app.py to read st.secrets[...] instead of the sidebar fields,
# if you want channels pre-filled every time instead of typing them in.

[smtp]
host = "smtp.gmail.com"
port = 587
user = "you@gmail.com"
password = "your-16-char-app-password"   # Gmail: use an "App Password", not your real password
to = "ops-team@yourcompany.com"

[twilio]
account_sid = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
auth_token = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
from_number = "+15551234567"
to_number = "+15557654321"

[slack]
webhook_url = "https://hooks.slack.com/services/T000/B000/XXXXXXXXXXXXXXXXXXXXXXXX"
